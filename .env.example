NEXT_PUBLIC_SUPABASE_URL=https://tzariztovuuwyeoogbxg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# TridiMarket legado — service role, apesar do nome histórico da variável.
# Somente servidor: nunca usar NEXT_PUBLIC_ nem embutir no APK.
TRIDIMARKET_SUPABASE_ANONKEY=your-tridimarket-service-role-key

# ERP legado (irdptdvk) — OBRIGATÓRIO p/ o ranking/comercial (lê vendas_planilha via RLS)
LEGACY_SUPABASE_URL=https://irdptdvkldrghevmtmzc.supabase.co
LEGACY_SERVICE_ROLE_KEY=your-legacy-service-role-key

# Autoriza os crons da Vercel. JÁ é usado pelos 5 crons existentes, mas estava
# faltando neste arquivo: sem ele, `authorized()` faz fail-open e qualquer um
# consegue disparar /api/sync, /api/meta/refresh etc.
CRON_SECRET=

# Backblaze B2 — armazenamento PRIVADO (anexo da Central, 
# selfie do ponto, anexo do Financeiro, nota do mercadinho). Público continua
# no Storage do Supabase. Sem as cinco, o app cai no Supabase como antes.
# Chave de aplicação RESTRITA ao bucket (a master key não funciona na API S3).
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET=tridi-privado
B2_KEY_ID=
B2_APP_KEY=
# Backblaze B2 — armazenamento PÚBLICO (foto de produto, mídia do LinkTridi e
# dos Tutoriais, logo, APK da TV). Bucket `allPublic` com CORS liberando PUT do
# app. B2_PUBLICO_URL = URL amigável do bucket (https://f005.backblazeb2.com/file/tridi-publico).
# Sem as quatro, o público cai no Supabase como antes.
B2_PUBLICO_BUCKET=tridi-publico
B2_PUBLICO_KEY_ID=
B2_PUBLICO_APP_KEY=
B2_PUBLICO_URL=

# Pagar.me (saldo do gateway no Financeiro): uma chave secreta por conta, PAGARME_SK_<NOME>.
# O recebedor (re_…) é descoberto sozinho; vai no campo Número da conta no cadastro.
PAGARME_SK_TRIDI=
