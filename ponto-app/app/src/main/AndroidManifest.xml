<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Saber quando a internet voltou, pra subir a fila na hora. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Coordenada da batida (carimbo na selfie + registro). Rede basta pra
         tablet dentro de galpão; FINE deixa o GPS refinar quando pegar. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <application
        android:label="Ponto Tridi"
        android:icon="@drawable/ic_ponto"
        android:theme="@style/Theme.Ponto"
        android:supportsRtl="false"
        android:largeHeap="true"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Também pode ser a tela inicial (HOME): como device owner, o tablet
                 liga direto no app e o botão Home não sai dele. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Administrador de dispositivo → habilita o kiosk total (device owner). -->
        <receiver
            android:name=".PontoAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
