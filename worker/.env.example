# Copie este arquivo para  .env  e preencha os dois valores.

# Base do seu dominio (sem barra no final). Ex.: https://app.suaempresa.com.br
WORKER_URL=https://SEU-DOMINIO

# O MESMO valor que voce colocou em TRIDIMARKET_WORKER_TOKEN no servidor.
# Use um texto longo e aleatorio (>= 24 caracteres).
WORKER_TOKEN=cole-aqui-o-token

# Segundos entre consultas quando nao ha nota na fila (padrao 5).
POLL_SECONDS=5
